# Supabase: `supabase status` prints local values; hosted values are in
# Project Settings → API. The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this app, used in auth email links (e.g. https://verdict.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
ANTHROPIC_API_KEY=
